# ==============================================================================
# FelCloud Resilient IP Optimizer - Environment Configuration
# ==============================================================================

# OpenStack Keystone Authentication
OS_AUTH_URL=https://identity.api.felcloud.io/v3/
OS_PROJECT_NAME=Default_Project_wildcard
OS_USERNAME=wildcard
OS_PASSWORD=your_secure_password_here
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default
OS_REGION_NAME=North-Africa

# OpenStack DNS (Designate) Configuration
DNS_ZONE=cstam.felcloud.tn.

# OpenStack Compute & Network Settings
OPENSTACK_NETWORK=demo_network
OPENSTACK_FLAVOR=m1.small
OPENSTACK_IMAGE=cirros
OPENSTACK_SECGROUP=default

# Dual HA Edge Gateways Configuration
GATEWAY_PRIMARY=gw1.felcloud.tn
GATEWAY_STANDBY=gw2.felcloud.tn
GATEWAY_VIP=10.0.0.5
GATEWAY_FLOATING_IP=192.168.1.100  # Public IP reached by students / DNS
GATEWAY_CONFIG_DIR=./gateway_configs

# IPAM Engine Configuration
IPAM_DB_PATH=ipam.db
IPAM_CIDR=10.0.0.0/24
IPAM_START_IP=10.0.0.10
IPAM_END_IP=10.0.0.250
IPAM_DEFAULT_LEASE=3600  # 1 hour short lease in seconds
